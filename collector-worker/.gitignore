# wrangler's local emulation state: the miniflare D1 volume, bundle temp dirs and
# the account-settings cache. All regenerated by `wrangler dev` / `d1 migrations
# apply`, none of it belongs in the repository.
.wrangler/

# Local overrides for `wrangler dev` — including MYTHICAL_TELEMETRY_OPS_KEY,
# which gates /metrics. Real secrets live in Cloudflare (`wrangler secret put`);
# this file is a convenience for local runs and must never be committed.
.dev.vars
.dev.vars.*
