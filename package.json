{
  "name": "mythical-telemetry",
  "version": "0.0.0",
  "description": "mythicalOS product telemetry \u2014 the shared heartbeat client (@mythicalos/telemetry) and the collector that ingests it. One repo so the schema, the emitter and the validator cannot drift apart.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "build": "bun run --filter '*' build",
    "check:manifest": "bun run packages/telemetry/scripts/check-field-classes.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mythicalOS/mythical-telemetry.git"
  },
  "workspaces": [
    "packages/*",
    "collector"
  ],
  "devDependencies": {
    "bun-types": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
