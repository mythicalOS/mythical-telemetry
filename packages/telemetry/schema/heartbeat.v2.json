{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mythical-telemetry/schema/heartbeat.v2.json",
  "title": "mythicalOS heartbeat v2",
  "description": "Daily product heartbeat for the mythicalOS family (brokkr, saga, skuld). Strictness IS the drop-rule: additionalProperties:false at EVERY level — including inside metrics — plus value discipline on every leaf, so a payload carrying prompts, transcripts, code, file paths, keys, repo/org names, hostnames, usernames, IPs, emails, SQL, job names or database identifiers is structurally rejected. Counts, ratios, buckets, booleans, closed enums and bounded version strings only. The payload carries NO auth material: write auth rides the X-Mythical-Write-Key transport header, never the schema. The document is PSEUDONYMOUS, not anonymous — instance_id is stable across days, so the daily rows form a longitudinal series; never describe it as anonymous. Changes from v1: product.daemon_version -> product.version, brokkr's ten top-level sections move VERBATIM under metrics, and metrics is discriminated on product.name via oneOf. Every leaf's value class and temporal class are declared in schema/field-classes.json and checked in CI by scripts/check-field-classes.ts; that check enforces SHAPE, not privacy. Cross-field invariants JSON Schema cannot express are noted in description fields below and enforced by the runtime validator in src/envelope.ts, kept in lockstep by test. schema_version is the discriminator; v3 would be a new file, never a silent widening of v2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "instance_id",
    "day",
    "product",
    "platform",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": 2,
      "description": "Version discriminator. v2 is strict; future versions are new schema files."
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "The ONLY identity: lowercase UUIDv4-shaped, derived as the first 16 bytes of sha256(instance_secret) with v4 version/variant bits. Uniformly random to any observer; only the secret-holder can authenticate as it (write auth = X-Mythical-Write-Key header, verified statelessly). PER PRODUCT — the three products never share one — and a copy destination receives a DIFFERENT, destination-scoped id, never the central one."
    },
    "day": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "The completed UTC day this document aggregates. Cross-field (ingest-enforced): must be a real calendar day, <= today UTC and >= today-30."
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "brokkr",
            "saga",
            "skuld"
          ],
          "description": "The bare family product key, matching /detect. CLOSED set, and the discriminator selecting the metrics body below."
        },
        "version": {
          "type": "string",
          "pattern": "^(\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|other)$",
          "description": "Strict semver-core OR the literal \"other\" (the emitter buckets anything non-semver). No org-nameable space. Renamed from v1's product.daemon_version."
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "arch"
      ],
      "properties": {
        "os": {
          "type": "string",
          "enum": [
            "darwin",
            "linux",
            "win32",
            "other"
          ]
        },
        "arch": {
          "type": "string",
          "enum": [
            "arm64",
            "x64",
            "other"
          ]
        }
      }
    },
    "metrics": {
      "type": "object",
      "description": "The per-product body. This placeholder is intentionally unconstrained here — every oneOf branch below pins it to exactly one $ref, so the effective shape is always a closed body with additionalProperties:false at every level. Do not add constraints here; add them to the branch definition."
    }
  },
  "oneOf": [
    {
      "properties": {
        "product": {
          "properties": {
            "name": {
              "const": "brokkr"
            }
          }
        },
        "metrics": {
          "$ref": "#/definitions/brokkr_metrics"
        }
      }
    },
    {
      "properties": {
        "product": {
          "properties": {
            "name": {
              "const": "saga"
            }
          }
        },
        "metrics": {
          "$ref": "#/definitions/saga_metrics"
        }
      }
    },
    {
      "properties": {
        "product": {
          "properties": {
            "name": {
              "const": "skuld"
            }
          }
        },
        "metrics": {
          "$ref": "#/definitions/skuld_metrics"
        }
      }
    }
  ],
  "definitions": {
    "brokkr_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config",
        "features",
        "sessions",
        "context_fill",
        "mode_split",
        "spine",
        "models",
        "tokens",
        "review",
        "errors"
      ],
      "description": "brokkr body — v1's ten top-level sections, moved VERBATIM under metrics. No leaf is added, removed, renamed or reclassified; the lockstep test asserts these nodes deep-equal heartbeat.v1.json's.",
      "properties": {
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backend",
            "harness_type",
            "wizard_completed",
            "team_size",
            "playbooks_active",
            "review_mode"
          ],
          "properties": {
            "backend": {
              "type": "string",
              "enum": [
                "local",
                "server"
              ]
            },
            "harness_type": {
              "type": "string",
              "enum": [
                "claude",
                "codex",
                "other"
              ]
            },
            "wizard_completed": {
              "type": "boolean"
            },
            "team_size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "playbooks_active": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "review_mode": {
              "type": "string",
              "enum": [
                "cross-model",
                "ephemeral"
              ]
            }
          }
        },
        "features": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "terminal",
            "edges"
          ],
          "properties": {
            "terminal": {
              "type": "boolean"
            },
            "edges": {
              "type": "boolean"
            }
          }
        },
        "sessions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "minutes",
            "failed"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "minutes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "description": "Cross-field (zod-enforced): sessions.failed <= sessions.count."
            }
          }
        },
        "context_fill": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "peak_histogram",
            "avg_mean"
          ],
          "properties": {
            "peak_histogram": {
              "type": "array",
              "minItems": 10,
              "maxItems": 10,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              },
              "description": "Per-session peak fill %, bucketed into EXACTLY 10 deciles: [0-10) ... [90-100]. Cross-field (zod-enforced): sum(peak_histogram) <= sessions.count (spawn failures carry no fill)."
            },
            "avg_mean": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Mean over FILL-BEARING sessions of per-session average fill PERCENT, in [0,100]; null iff zero fill-bearing sessions that day."
            }
          }
        },
        "mode_split": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "normal",
            "spine"
          ],
          "description": "Cross-field (zod-enforced): mode_split.normal + mode_split.spine === sessions.count.",
          "properties": {
            "normal": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "spine": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          }
        },
        "spine": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "joints",
            "tokens_before",
            "tokens_after",
            "estimated"
          ],
          "properties": {
            "joints": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "tokens_before": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "tokens_after": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "estimated": {
              "type": "boolean",
              "description": "true iff ANY joint that day used the daemon's length/4 fallback for after-tokens — an estimate must never masquerade as a hard count."
            }
          }
        },
        "models": {
          "type": "array",
          "maxItems": 16,
          "description": "Normalized model IDs only — a CLOSED allowlist of publicly-published IDs plus \"other\" (identity leak capacity zero; the allowlist ships as src/model-id-allowlist.ts and is kept equal to this enum by test). Cross-field (zod-enforced): sum(models[].sessions) <= sessions.count.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "sessions"
            ],
            "properties": {
              "name": {
                "type": "string",
                "enum": [
                  "claude-fable-5",
                  "claude-opus-4-8",
                  "claude-sonnet-5",
                  "claude-haiku-4-5-20251001",
                  "claude-opus-4-1",
                  "claude-sonnet-4-20250514",
                  "claude-3-5-haiku-20241022",
                  "gpt-5",
                  "gpt-4.1",
                  "o3",
                  "codex-mini-latest",
                  "gemini-2.5-pro",
                  "gemini-2.5-flash",
                  "other"
                ]
              },
              "sessions": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              }
            }
          }
        },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input",
            "cache_read",
            "cache_creation",
            "output"
          ],
          "description": "Whole-session raw SDK usage sums (all-assistant scope, including subagent/sidechain usage).",
          "properties": {
            "input": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "cache_read": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "cache_creation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "output": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runs"
          ],
          "properties": {
            "runs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          }
        },
        "errors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classes"
          ],
          "properties": {
            "classes": {
              "type": "object",
              "additionalProperties": false,
              "description": "CLOSED key taxonomy (v1: session_failed only); grows ONLY by schema-version bump — never free keys. Cross-field (zod-enforced): sum of class counts <= sessions.count.",
              "properties": {
                "session_failed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000
                }
              }
            }
          }
        }
      }
    },
    "saga_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collect",
        "refusals",
        "mcp",
        "advisories",
        "connections",
        "probe",
        "uptime_bucket"
      ],
      "description": "saga body — database-monitoring counts and gauges. Never a database, schema, table, column, host or DSN.",
      "properties": {
        "collect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runs",
            "errors"
          ],
          "properties": {
            "runs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "Completed collector runs that day (delta)."
            },
            "errors": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "Collector runs that errored that day (delta)."
            }
          }
        },
        "refusals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000,
          "description": "Read-only-guard refusals that day (delta). No SQL, no statement, no connection name."
        },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool_calls",
            "refusals"
          ],
          "properties": {
            "tool_calls": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "MCP tool calls served that day (delta). Never a tool name or an argument."
            },
            "refusals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "MCP tool calls refused that day (delta)."
            }
          }
        },
        "advisories": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fired",
            "by_severity"
          ],
          "properties": {
            "fired": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "Advisories fired that day (delta)."
            },
            "by_severity": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "info",
                "warn",
                "critical"
              ],
              "description": "CLOSED severity taxonomy — grows only by schema-version bump, never free keys. No cross-field relation to advisories.fired is asserted: the two are separate counters, so a mis-instrumented call site would make an otherwise correct day structurally invalid and lose it silently.",
              "properties": {
                "info": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "warn": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "critical": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                }
              }
            }
          }
        },
        "connections": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "by_engine",
            "total"
          ],
          "description": "Gauges — last sample of the day wins; never summed across days.",
          "properties": {
            "by_engine": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "postgres",
                "mysql",
                "sqlite"
              ],
              "description": "CLOSED engine-family taxonomy — a count per family, never a connection name, host, database or DSN. An unrecognised engine is not emitted.",
              "properties": {
                "postgres": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000
                },
                "mysql": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000
                },
                "sqlite": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000
                }
              }
            },
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "description": "Registered connections right now (gauge). Cross-field (validator-enforced): >= sum(by_engine) — both are derived from the same registry list in one pass, so this holds by construction."
            }
          }
        },
        "probe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcomes"
          ],
          "properties": {
            "outcomes": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "auth_failed",
                "unreachable",
                "timeout",
                "other"
              ],
              "description": "CLOSED outcome taxonomy (delta). Never an error string, host or database name — an unrecognised outcome buckets to `other`.",
              "properties": {
                "ok": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "auth_failed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "unreachable": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "timeout": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "other": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                }
              }
            }
          }
        },
        "uptime_bucket": {
          "type": "string",
          "enum": [
            "<1h",
            "1h-1d",
            "1d-7d",
            "7d-30d",
            "30d+"
          ],
          "description": "Coarse, non-reversible uptime bucket (gauge — last sample of the day wins). The raw second count is never carried."
        }
      }
    },
    "skuld_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobs",
        "runs",
        "events",
        "gate",
        "sandbox",
        "detection_state",
        "uptime_bucket"
      ],
      "description": "skuld body — job-scheduling counts and gauges. Never a job name, script source, prompt, path or peer address.",
      "properties": {
        "jobs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created_by_type"
          ],
          "properties": {
            "created_by_type": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "script",
                "ai",
                "report",
                "agent_send",
                "distill"
              ],
              "description": "CLOSED job-type taxonomy (delta) — grows only by schema-version bump. Never a job name, script source, prompt or path.",
              "properties": {
                "script": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "ai": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "report": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "agent_send": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "distill": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                }
              }
            }
          }
        },
        "runs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "succeeded",
            "failed",
            "chain_rejections"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "succeeded": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "chain_rejections": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            }
          }
        },
        "events": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deferrals"
          ],
          "properties": {
            "deferrals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            }
          }
        },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rejections",
            "approvals"
          ],
          "properties": {
            "rejections": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "approvals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            }
          }
        },
        "sandbox": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pool_exhausted",
            "uid_vends"
          ],
          "properties": {
            "pool_exhausted": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "uid_vends": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            }
          }
        },
        "detection_state": {
          "type": "string",
          "enum": [
            "unknown",
            "detected",
            "not_detected"
          ],
          "description": "Whether a sibling product was detected on the shared network (gauge). A CLOSED enum, never the raw integer the local counter holds, and never a peer address, name or version."
        },
        "uptime_bucket": {
          "type": "string",
          "enum": [
            "<1h",
            "1h-1d",
            "1d-7d",
            "7d-30d",
            "30d+"
          ],
          "description": "Coarse, non-reversible uptime bucket (gauge — last sample of the day wins). The raw second count is never carried."
        }
      }
    }
  }
}
